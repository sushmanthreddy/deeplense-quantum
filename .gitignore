# The repository is an allowlist: unknown top-level content stays local.
/*

# Repository controls and Markdown documentation.
!/.gitignore
!/.gitattributes
!/*.md

# Compact Python package: exactly the main-like eight-module layout.
!/src/
/src/*
!/src/README.md
!/src/requirements.txt
!/src/d4_orqb/
/src/d4_orqb/*
!/src/d4_orqb/__init__.py
!/src/d4_orqb/config.py
!/src/d4_orqb/data.py
!/src/d4_orqb/encoder.py
!/src/d4_orqb/engine.py
!/src/d4_orqb/main.py
!/src/d4_orqb/model.py
!/src/d4_orqb/quantum.py

# Canonical dataset notebook implementations only.
!/notebooks/
/notebooks/*
!/notebooks/d4_orqb/
/notebooks/d4_orqb/*
!/notebooks/d4_orqb/train_model_i.ipynb
!/notebooks/d4_orqb/train_model_ii.ipynb
!/notebooks/d4_orqb/train_model_iii.ipynb
!/notebooks/d4_orqb/train_model_iv.ipynb
!/notebooks/d4_orqb/train_model_v.ipynb

# Static assets may be selected deliberately; generated run figures stay ignored.
!/assets/
/assets/*
!/assets/**/
!/assets/**/*.md
!/assets/**/*.png
!/assets/**/*.jpg
!/assets/**/*.jpeg
!/assets/**/*.gif
!/assets/**/*.svg
!/assets/**/*.pdf

# The weights directory may contain documentation, but generated weights are ignored.
!/weights/
/weights/*
!/weights/README.md

# Generated runner manifests and structured run state are never committed.
runner.yaml
*.yaml
*.yml
*.json

# Datasets, caches, arrays, checkpoints, logs, outputs, and archives.
*.npy
*.npz
*.pt
*.pth
*.ckpt
*.safetensors

# Explicitly selected, documented final checkpoints.
!/weights/
!/weights/README.md
!/weights/model_1/
!/weights/model_1/best.pt
!/weights/model_2/
!/weights/model_2/best.pt
!/weights/model_3/
!/weights/model_3/best.pt
!/weights/model_4/
!/weights/model_4/best.pt
!/weights/model_5/
!/weights/model_5/best.pt
*.log
*.tar
*.tar.gz
*.tgz
*.zip
cache/
caches/
data/
datasets/
outputs/
runs/
results/
artifacts/

# Python/Jupyter/editor noise.
.DS_Store
**/.DS_Store
**/__pycache__/
*.py[cod]
**/.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
